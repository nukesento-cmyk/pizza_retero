# Copy to .env (root) — never commit real values.

# --- Database ---------------------------------------------------------------
# Runtime role (NOBYPASSRLS). Used by the app.
DATABASE_URL=postgres://retero_app:retero_app_dev@localhost:54329/retero
# System role (BYPASSRLS). Payment callbacks, guest checkout, worker only.
DATABASE_SYSTEM_URL=postgres://retero_system:retero_system_dev@localhost:54329/retero
# Owner role. Used ONLY for migrations and seeding.
DATABASE_OWNER_URL=postgres://retero_owner:retero_owner_dev@localhost:54329/retero

# --- Environment ----------------------------------------------------------
# local | preview | production. Non-local requires Supabase Auth to be configured.
APP_ENV=local

# --- Public site ------------------------------------------------------------
# Hostname used when the request host has no domain row (local dev).
APP_FALLBACK_BRAND_SLUG=retero
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase Auth (managed authentication) ---------------------------------
# Project Settings → API. The anon/publishable key is safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Security ---------------------------------------------------------------
# 32+ random bytes, base64. Used to hash IPs in audit logs.
AUDIT_IP_SALT=

# --- Local-only development sign-in (refused unless APP_ENV=local) -----------
# Lets you sign in as any email without Supabase. Leave empty to disable.
DEV_AUTH_SECRET=

# --- Object storage (S3-compatible: SeaweedFS locally, Supabase Storage/S3 in prod) ---
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_BUCKET=retero-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
