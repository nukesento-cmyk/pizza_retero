      "checkConstraints": {
        "memberships_scope_shape": {
          "name": "memberships_scope_shape",
          "value": "CASE \"memberships\".\"scope_type\"\n        WHEN 'platform'   THEN \"memberships\".\"brand_id\" IS NULL AND \"memberships\".\"franchisee_id\" IS NULL AND \"memberships\".\"branch_id\" IS NULL\n        WHEN 'brand'      THEN \"memberships\".\"brand_id\" IS NOT NULL AND \"memberships\".\"franchisee_id\" IS NULL AND \"memberships\".\"branch_id\" IS NULL\n        WHEN 'franchisee' THEN \"memberships\".\"brand_id\" IS NOT NULL AND \"memberships\".\"franchisee_id\" IS NOT NULL AND \"memberships\".\"branch_id\" IS NULL\n        WHEN 'branch'     THEN \"memberships\".\"brand_id\" IS NOT NULL AND \"memberships\".\"franchisee_id\" IS NULL AND \"memberships\".\"branch_id\" IS NOT NULL\n      END"
        },
        "memberships_revoke_pair": {
          "name": "memberships_revoke_pair",
          "value": "(\"memberships\".\"revoked_at\" IS NULL) = (\"memberships\".\"revoked_by\" IS NULL)"
        }
